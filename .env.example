# VendorsDesk Frontend Environment Variables
# Copy to `.env` or `.env.local` to override defaults.

# Backend API base URL (leave empty in local dev to use Vite proxy /api -> http://localhost:5000)
VITE_BACKEND_URL=

# Google OAuth Client ID for Google Sign-In
VITE_GOOGLE_CLIENT_ID=148360176717-1dpf5u3v99ckjhu5gruud4f9u17uqoc2.apps.googleusercontent.com

# Razorpay Checkout Key (Client-side ID)
VITE_RAZORPAY_KEY_ID=
